{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: dev",
      "type": "shell",
      "command": "source backend/.venv/bin/activate && uvicorn app.main:app --app-dir backend --reload --port 8000",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: dev",
      "type": "shell",
      "command": "npm --prefix frontend run dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Check all",
      "type": "shell",
      "command": "./scripts/check.sh",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
